{
 "headers": [
  {
   "source": "/data/(.*).json.gz",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/octet-stream"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/data/chapters.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ],
 "cleanUrls": true
}