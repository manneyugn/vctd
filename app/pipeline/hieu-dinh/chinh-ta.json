  "regex": {
    "(?i)(?<![A-Za-zÀ-ỹ])([v])ân ([v])ũ(?![A-Za-zÀ-ỹ])(?!\\s*trụ)": "\\1ân \\2õ",
    "(?<=mươi) mươi(?= )": "",
    "(?<![^\\W\\d_])([Cc])h\\.ết": "\\1hết",
    "(?<![A-Za-zÀ-ỹ])(?<!Cố )Lâm\\s+Phong(?![A-Za-zÀ-ỹ])": "Trương Nhược Trần",
    "Tu Chân thần thần": "Tu Thần Thiên Thần",
    "(?<![A-Za-zÀ-ỹ])Baal(?![A-Za-zÀ-ỹ])": "Ba Nhĩ",
    "(?<![A-Za-zÀ-ỹ])(?<!Phủ, )Thiên Mẫu(?![A-Za-zÀ-ỹ])(?!\\s+[Gg]iới)": "Thiên Mụ",
    "(?<![A-Za-zÀ-ỹ])Thương (?:Gi tuyệt|C tuyệt|Giữ|Giệt|Gi)(?![A-Za-zÀ-ỹ])": "Thương Tuyệt",
    "(?<![A-Za-zÀ-ỹ])(?:Cái|Cải|Xích) Thiên Ki(?:ều|êu)(?![A-Za-zÀ-ỹ])": "Cái Thiên Kiêu",
    "Thiên Kiều Tọa": "Thiên Kiêu Tọa",
    "(?<![A-Za-zÀ-ỹ])[Tt]hiên [Cc](?:ổ|ốt) (?:[Nn]ữ [Đđ]ế|[Nn]ữ [Hh]oàng)(?![A-Za-zÀ-ỹ])": "Thiên Cốt Nữ Đế",
    "Thiên Cổ Thể Chất": "Thiên Cốt Thể Chất",
    "Thiên Cốt thể chất": "Thiên Cốt Thể Chất",
    "(?<![A-Za-zÀ-ỹ])(?:Thần Vẫn|Vẫn Thần) [Đđ]ảo(?![A-Za-zÀ-ỹ])": "Vẫn Thần Đảo",
    "Vẫn Thần Kinh": "Thần Vẫn Kinh",
    "Hoa Ảnh Khinh (?:Thiềm|Thuyền)": "Hoa Ảnh Khinh Thiền",
    "Hoa Ảnh Thương (?:Cật|Cuyết|Hiệt|Kiệt|Hiết)": "Hoa Ảnh Thương Hiệt",
    "(?<![A-Za-zÀ-ỹ])(?:Thần Vẫn|Vẫn Thần) [Tt]ộc(?![A-Za-zÀ-ỹ])": "Thần Vẫn Tộc",
    "Huyết V tuyệt": "Huyết Tuyệt",
    "(?<![A-Za-zÀ-ỹĐđ])(?<!một )(?<!Một )(?<!phân )(?<!quá )[Nn]ửa [Tt]hánh(?![A-Za-zÀ-ỹĐđ])": "Bán Thánh",
    "(?<![A-Za-zÀ-ỹĐđ])(?<!một )(?<!Một )(?<!phân )(?<!quá )[Nn]ửa [Tt]hần(?! thánh)(?! thi)(?![A-Za-zÀ-ỹĐđ])": "Bán Thần",
    "(?<![A-Za-zÀ-ỹĐđ])(?<!một )(?<!Một )(?<!phân )(?<!quá )[Nn]ửa [Tt]ổ(?![A-Za-zÀ-ỹĐđ])": "Bán Tổ",
    "(?<![A-Za-zÀ-ỹĐđ])(?:[Nn]ửa bước|[Bb]án [Bb]ộ) [Tt]hánh [Vv]ương(?![A-Za-zÀ-ỹĐđ])": "Bán Bộ Thánh Vương",
    "Trương Nhược Trần \\((?:không, )?Trương Nhược Trần\\)": "Trương Nhược Trần",
    "Trưởng Lại \\(Trương Nhược Trần\\)": "Trương Nhược Trần",
    "Huyết Giệt \\(Giết\\)\\.\\.\\. ": "",
    "Ngô Đồng Thần X thụ": "Ngô Đồng Thần Thụ",
    "Tu MDi": "Tu Di",
    "Hồng A Vua \\(Hongya Wang\\)": "Hồng Nha Vương",
    "Tinh Sử(?![a-zà-ỹ])": "Tinh Sứ"
  }
}
